{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/brian-vc/prospectus-extractor/case_data.schema.json",
  "title": "Prospectus Extractor case_data",
  "description": "Canonical, style-independent source of truth for all prospectus-extractor outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case",
    "sources",
    "coverage",
    "raw_sections",
    "sheets",
    "conflicts",
    "red_flags",
    "missing_items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "company_name", "stock_code", "title", "currency", "unit"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "stock_code": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "coverage": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/coverageItem"}
    },
    "raw_sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/rawSection"}
    },
    "sheets": {
      "type": "array",
      "minItems": 35,
      "items": {"$ref": "#/$defs/sheet"}
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "red_flags": {
      "type": "array",
      "items": {"$ref": "#/$defs/redFlag"}
    },
    "missing_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/missingItem"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "status": {
      "enum": ["complete", "partial", "missing", "not_applicable"]
    },
    "cell": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "path_or_url",
        "snapshot_path",
        "document_date",
        "retrieved_at",
        "sha256",
        "pages"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
        "role": {
          "enum": [
            "prospectus",
            "prospectus_revision",
            "audited_fs_consolidated",
            "audited_fs_individual",
            "annual_report",
            "interim_fs",
            "dataroom_supplement"
          ]
        },
        "path_or_url": {"type": "string", "minLength": 1},
        "snapshot_path": {"type": ["string", "null"]},
        "document_date": {"type": ["string", "null"], "format": "date"},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "pages": {"type": ["integer", "null"], "minimum": 1},
        "notes": {"type": "string"}
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "source_refs", "sheet_names", "reason"],
      "properties": {
        "id": {
          "enum": [
            "W01", "W02", "W03", "W04", "W05", "W06",
            "W07", "W08", "W09", "W10", "W11", "W12",
            "W13", "W14", "W15", "W16", "W17", "W18",
            "W19", "W20", "W21", "W22", "W23", "W24"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "source_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "sheet_names": {
          "type": "array",
          "items": {"type": "string"}
        },
        "reason": {"type": ["string", "null"]},
        "locations": {
          "type": "array",
          "items": {"$ref": "#/$defs/citation"}
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "physical_page"],
      "properties": {
        "source_id": {"type": "string"},
        "physical_page": {"type": ["integer", "null"], "minimum": 1},
        "printed_page": {"type": ["string", "integer", "null"]},
        "sheet": {"type": ["string", "null"]},
        "cell_or_range": {"type": ["string", "null"]},
        "method": {
          "enum": ["text_layer", "ocr", "vision", "spreadsheet", "manual", "unknown"]
        },
        "note": {"type": "string"}
      }
    },
    "rawSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "title", "content", "citations"],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "citations": {
          "type": "array",
          "items": {"$ref": "#/$defs/citation"}
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "header", "rows", "reason"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 31},
        "status": {"$ref": "#/$defs/status"},
        "header": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/cell"}
          }
        },
        "reason": {"type": ["string", "null"]},
        "no_header": {"type": "boolean"},
        "top": {"type": "boolean"},
        "widths": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "numcols": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "pct_cols": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "section_rows": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "conflictCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_id", "location"],
      "properties": {
        "value": {},
        "source_id": {"type": "string"},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "status", "candidates", "selected_value", "selection_rule"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "status": {"enum": ["resolved", "conflict_unresolved"]},
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/conflictCandidate"}
        },
        "selected_value": {},
        "selection_rule": {"type": ["string", "null"]}
      }
    },
    "redFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "detail", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "source_refs": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "missingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "status", "reason"],
      "properties": {
        "item": {"type": "string", "minLength": 1},
        "status": {"enum": ["missing", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "suggested_source": {"type": ["string", "null"]}
      }
    }
  }
}
