{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.brian-vc/styles/style.schema.json",
  "title": "VC Report Style",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "display_name",
    "instructions",
    "targets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["md", "docx", "xlsx", "pptx"]
      }
    }
  }
}
